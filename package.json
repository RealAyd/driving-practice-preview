{
  "name": "driving-practice-sim",
  "private": true,
  "type": "module",
  "description": "Driving Practice judgement simulator rebuild (TypeScript, Vite, Babylon.js). The legacy A-Frame app stays in /index.html.",
  "scripts": {
    "dev": "vite --config sim/vite.config.ts",
    "build": "npm run typecheck && vite build --config sim/vite.config.ts",
    "preview": "vite preview --config sim/vite.config.ts --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test tests/migration.test.mjs",
    "test:browser": "playwright test",
    "stress": "vitest run --config vitest.stress.config.ts",
    "build:server": "tsc -p server/tsconfig.check.json && tsc -p server/tsconfig.json",
    "start:server": "node server/dist/index.js",
    "dev:server": "npm run build:server && DP_DEV_FAKES=1 node server/dist/index.js"
  },
  "dependencies": {
    "@babylonjs/core": "9.31.0",
    "@babylonjs/loaders": "9.31.0",
    "jose": "^6.2.13",
    "mongodb": "^7.7.0",
    "stripe": "^23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "mongodb-memory-server-core": "^11.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
